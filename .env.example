# IP da Mi Box; opcional. Se faltar ou a TV mudar de IP, a rede em TV_SUBNET é varrida.
TV_HOST=192.168.1.50:5555
TV_SUBNET=192.168.1.0/24
# Trecho do modelo da TV (adb shell getprop ro.product.model), para não pegar outro aparelho com ADB
TV_MODEL=
# Ordem de escolha quando você não diz o app ("assistir Matrix")
SERVICE_PRIORITY=netflix,prime,disney,globoplay,max
# YouTube Data API v3 (console.cloud.google.com), para "assistir X no YouTube"
YOUTUBE_API_KEY=
# developer.spotify.com/dashboard (grátis), para "tocar X no Spotify"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SKILL_ID=amzn1.ask.skill.xxxxxxxx
TEST_TOKEN=troque-por-um-segredo-longo

# Atualiza a lista de títulos da skill sozinho (1x por semana) pelo ASK CLI; serviços do JustWatch: prv Prime, dnp Disney+, nfx Netflix, gop Globoplay, mxx HBO Max
AUTO_TITLES=1
TITLES_PACKAGES=prv,dnp
